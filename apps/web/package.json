{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wrangler d1 migrations apply DB --local && vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --run",
		"test": "pnpm test:unit && pnpm test:workers",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"test:workers": "vitest --run --config vitest.workers.config.ts",
		"perf:data": "vitest --run --config vitest.perf.config.ts",
		"perf:bundle": "playwright test --grep @perf --project=chromium",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:seed": "node scripts/seed-local.ts",
		"db:backfill-thumbnails": "node scripts/backfill-thumbnails.ts",
		"owner:grant": "node scripts/owner-grant.ts",
		"e2e:server": "rm -rf .wrangler/e2e && wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e && wrangler dev --port 4173 --persist-to .wrangler/e2e"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@hono/standard-validator": "^0.4.0",
		"@infixer-link/content": "workspace:*",
		"@infixer-link/contracts": "workspace:*",
		"@infixer-link/time": "workspace:*",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"@standard-schema/spec": "^1.1.0",
		"hono": "^4.13.13",
		"idb": "^8.0.4",
		"valibot": "^1.5.0"
	}
}
