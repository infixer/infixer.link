{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "infixer-link",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Design §9.8: do not expose workers.dev / preview hosts. WebAuthn only on fixed origins.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"SITE_TIME_ZONE": "Asia/Tokyo",
		"APP_ENV": "local",
		// WebAuthn RP ID and the exact origins allowed to authenticate / mutate.
		// Fixed per environment (ADR 0004); never derived from the Host header.
		// production: RP_ID "infixer.link", APP_ORIGINS "https://infixer.link"
		// staging:    RP_ID "staging.infixer.link", APP_ORIGINS "https://staging.infixer.link"
		"RP_ID": "localhost",
		"APP_ORIGINS": "http://localhost:5173,http://localhost:4173"
	},
	// Local-only placeholders. Real resource IDs are created per environment
	// (staging/production) with explicit user approval; never guess them.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "infixer-link-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "infixer-link-media-local" },
		{ "binding": "PENDING", "bucket_name": "infixer-link-pending-local" },
		{ "binding": "BACKUP", "bucket_name": "infixer-link-backup-local" }
	]
}
